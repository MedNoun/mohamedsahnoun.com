---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import SiteContent from '../components/SiteContent.astro';
import Console from '../components/Console';
import { site } from '../data/site';
---

<Base title={`${site.name}, ${site.title}`}>
  <Masthead variant="console" />

  <aside class="console-region" aria-label="Query console">
    <Console client:idle />
  </aside>

  <main class="wrap" id="content">
    <SiteContent />
  </main>

  <footer class="wrap site-footer">
    <p>Built with Astro. Every number on this page comes from a verified write-up of the work.</p>
  </footer>
</Base>

<style>
  /*
   * The console holds a table, and a table is the one element on this page that
   * wants width. It tracks .wrap at narrow sizes, then breaks out of the 68ch
   * prose measure once there is room, so cells stop being ellipsised.
   */
  .console-region {
    max-width: 76ch;
    margin: 0 auto calc(var(--space) * 12);
    padding: 0 calc(var(--space) * 5);
  }

  @media (min-width: 1024px) {
    .console-region {
      max-width: 940px;
    }
  }

  .site-footer {
    padding: calc(var(--space) * 10) 0 calc(var(--space) * 16);
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: var(--t--2);
  }
</style>
