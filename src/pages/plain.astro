---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import SiteContent from '../components/SiteContent.astro';
import { site } from '../data/site';
---

<Base
  title={`${site.name}, ${site.title}, plain text`}
  description={`Every case study from ${site.domain} as one plain scrolling document: BigQuery and Dataform platform work, entity resolution, and from-scratch BitTorrent and Kerberos implementations.`}
>
  <Masthead variant="plain" />

  <main class="wrap" id="content">
    <SiteContent />
  </main>

  <footer class="wrap site-footer">
    <p>
      This is the plain document version. The <a href="/">console version</a> holds the identical content.
    </p>
  </footer>
</Base>

<style>
  .site-footer {
    padding: calc(var(--space) * 10) 0 calc(var(--space) * 16);
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: var(--t--2);
  }
</style>
